{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    },
    "ecc": {
      "source": {
        "source": "github",
        "repo": "affaan-m/everything-claude-code"
      }
    },
    "claude-code-workflows": {
      "source": {
        "source": "github",
        "repo": "wshobson/agents"
      }
    }
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true,
    "ecc@ecc": true,
    "javascript-typescript@claude-code-workflows": true,
    "frontend-mobile-development@claude-code-workflows": true,
    "backend-development@claude-code-workflows": true,
    "full-stack-orchestration@claude-code-workflows": true,
    "developer-essentials@claude-code-workflows": true,
    "unit-testing@claude-code-workflows": true,
    "tdd-workflows@claude-code-workflows": true,
    "security-scanning@claude-code-workflows": true,
    "api-scaffolding@claude-code-workflows": true,
    "database-design@claude-code-workflows": true,
    "ui-design@claude-code-workflows": true,
    "git-pr-workflows@claude-code-workflows": true,
    "debugging-toolkit@claude-code-workflows": true,
    "comprehensive-review@claude-code-workflows": true,
    "cicd-automation@claude-code-workflows": true,
    "deployment-strategies@claude-code-workflows": true,
    "accessibility-compliance@claude-code-workflows": true,
    "python-development@claude-code-workflows": true,
    "payment-processing@claude-code-workflows": true,
    "application-performance@claude-code-workflows": true,
    "code-refactoring@claude-code-workflows": true,
    "error-debugging@claude-code-workflows": true,
    "documentation-generation@claude-code-workflows": true,
    "llm-application-dev@claude-code-workflows": true,
    "agent-orchestration@claude-code-workflows": true,
    "multi-platform-apps@claude-code-workflows": true,
    "context-management@claude-code-workflows": true
  },
  "enableAllProjectMcpServers": true,
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "/home/user/ONE-SHOT-APPS/.claude/mods/agent-ctx:/home/user/ONE-SHOT-APPS/.claude/mods/context-band:/home/user/ONE-SHOT-APPS/.claude/mods/loop-guard:/home/user/ONE-SHOT-APPS/.claude/mods/spawn-ledger:/home/user/ONE-SHOT-APPS/.claude/mods/voice-compact",
    "AGENCY_HOME": "/home/user/ONE-SHOT-APPS/.claude"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/user/ONE-SHOT-APPS/.claude/hooks/gate-guard.sh"
          },
          {
            "type": "command",
            "command": "bash /home/user/ONE-SHOT-APPS/.claude/hooks/config-protection.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/user/ONE-SHOT-APPS/.claude/hooks/secret-scanner.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/user/ONE-SHOT-APPS/.claude/hooks/spawn-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/user/ONE-SHOT-APPS/.claude/hooks/track-edits.sh"
          },
          {
            "type": "command",
            "command": "bash /home/user/ONE-SHOT-APPS/.claude/hooks/write-evidence.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/user/ONE-SHOT-APPS/.claude/hooks/loop-detector.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/user/ONE-SHOT-APPS/.claude/hooks/artifact-verify.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/user/ONE-SHOT-APPS/.claude/hooks/startup-sync.sh"
          },
          {
            "type": "command",
            "command": "bash /home/user/ONE-SHOT-APPS/.claude/hooks/check-settings-secrets.sh"
          },
          {
            "type": "command",
            "command": "bash /home/user/ONE-SHOT-APPS/.claude/hooks/check-session-state.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/user/ONE-SHOT-APPS/.claude/hooks/session-end.sh && bash /home/user/ONE-SHOT-APPS/.claude/hooks/batch-check.sh && bash /home/user/ONE-SHOT-APPS/.claude/hooks/cost-tracker.sh"
          }
        ]
      }
    ]
  }
}
